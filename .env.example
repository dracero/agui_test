# ============================================
# GOOGLE GEMINI API CONFIGURATION
# ============================================
# Obtén tu API key en: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ============================================
# QDRANT VECTOR DATABASE CONFIGURATION
# ============================================
# Para Qdrant Cloud: https://cloud.qdrant.io/
# Formato: https://your-cluster-name.cloud.qdrant.io:6333
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io:6333
QDRANT_KEY=your_qdrant_api_key_here

# Para Qdrant Local (desarrollo):
# QDRANT_URL=http://localhost:6333
# QDRANT_KEY=

# Nombre de la colección en Qdrant
QDRANT_COLLECTION_NAME=documentos_pdf

# ============================================
# PDF DOCUMENTS DIRECTORY
# ============================================
# Ruta al directorio que contiene los PDFs de física
# Por defecto: ./pdfs
DIR_PDF=/home/user/Descargas/fisica_apuntes

# ============================================
# BACKEND URL (para el frontend)
# ============================================
# URL donde corre el backend FastAPI
BACKEND_URL=http://localhost:8000

# ============================================
# LANGFUSE (OPCIONAL - Observabilidad)
# ============================================
# Si quieres usar Langfuse para monitoreo, descomenta y configura:
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. Copia este archivo como .env en la raíz del proyecto
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NUNCA subas el archivo .env a Git (ya está en .gitignore)
# 4. Las advertencias de Langfuse son normales si no configuras esas variables
