# ============================================
# 🔑 GOOGLE GEMINI API CONFIGURATION
# ============================================
# Obtén tu API key en: https://makersuite.google.com/app/apikey
# Esta key es OBLIGATORIA para que funcione el sistema
GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# 🗄️ QDRANT VECTOR DATABASE CONFIGURATION
# ============================================

# --- OPCIÓN 1: Qdrant Cloud (Recomendado para producción) ---
# Crea una cuenta gratis en: https://cloud.qdrant.io/
# Formato de URL: https://tu-cluster-id.cloud.qdrant.io:6333
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.cloud.qdrant.io:6333
QDRANT_KEY=your_qdrant_api_key_here_32_characters_long

# --- OPCIÓN 2: Qdrant Local (Para desarrollo) ---
# Ejecuta: docker run -p 6333:6333 qdrant/qdrant
# Luego usa estas configuraciones:
# QDRANT_URL=http://localhost:6333
# QDRANT_KEY=

# Nombre de la colección en Qdrant (puedes cambiarlo)
QDRANT_COLLECTION_NAME=documentos_pdf

# ============================================
# 📚 PDF DOCUMENTS DIRECTORY
# ============================================
# Ruta ABSOLUTA al directorio que contiene los PDFs de física
# Ejemplos:
#   Linux/Mac: /home/usuario/Documentos/fisica_pdfs
#   Windows: C:/Users/usuario/Documents/fisica_pdfs
# Si no se especifica, usa ./pdfs por defecto
DIR_PDF=/home/user/Descargas/fisica_apuntes

# ============================================
# 🌐 BACKEND URL (para el frontend Next.js)
# ============================================
# URL donde corre el backend FastAPI
# Desarrollo local: http://localhost:8000
# Producción: https://tu-dominio.com
BACKEND_URL=http://localhost:8000

# ============================================
# 📊 LANGFUSE (OPCIONAL - Observabilidad/Monitoreo)
# ============================================
# Langfuse es una herramienta de observabilidad para LLMs
# Si NO configuras estas variables, verás advertencias pero la app funcionará
# Para usarlo: https://cloud.langfuse.com/
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================
# ⚙️ CONFIGURACIÓN AVANZADA (Opcional)
# ============================================

# --- Configuración del Modelo Gemini ---
# Puedes cambiar el modelo en agent/agent.py
# Opciones: gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash
# Por defecto usa: gemini-2.5-flash

# --- Puerto del Backend ---
# Si quieres cambiar el puerto del backend (por defecto 8000)
# Modifica también BACKEND_URL arriba
# PORT=8000

# --- Configuración de Embeddings ---
# Modelo de embeddings usado (configurado en agent.py)
# Por defecto: sentence-transformers/all-MiniLM-L6-v2

# --- Tamaño de chunks para PDFs ---
# Tamaño de fragmentos al procesar PDFs (configurado en agent.py)
# Por defecto: 2000 caracteres

# --- Número de resultados de búsqueda ---
# Cantidad de fragmentos a recuperar de Qdrant (configurado en agent.py)
# Por defecto: 5

# ============================================
# 🔒 SEGURIDAD
# ============================================
# ⚠️ IMPORTANTE:
# 1. NUNCA subas este archivo .env a Git
# 2. NUNCA compartas tus API keys públicamente
# 3. Usa .env.local para configuraciones locales específicas
# 4. En producción, usa variables de entorno del servidor
# 5. Rota tus keys periódicamente

# ============================================
# 📝 INSTRUCCIONES DE USO
# ============================================
# 1. Copia este archivo:
#    cp .env.example .env
#
# 2. Edita .env con tus credenciales reales:
#    nano .env  (o usa tu editor favorito)
#
# 3. Reemplaza los valores de ejemplo:
#    - GOOGLE_API_KEY: Tu key real de Google
#    - QDRANT_URL: Tu URL de Qdrant
#    - QDRANT_KEY: Tu API key de Qdrant
#    - DIR_PDF: Ruta real a tus PDFs
#
# 4. Guarda el archivo y ejecuta:
#    npm run dev
#
# 5. Si ves advertencias de Langfuse, es normal si no configuraste esas variables

# ============================================
# 🐛 TROUBLESHOOTING
# ============================================
# Error: "GOOGLE_API_KEY not found"
#   → Verifica que el archivo .env existe en la raíz del proyecto
#   → Asegúrate de que la variable esté sin espacios: GOOGLE_API_KEY=tu_key
#
# Error: "Connection to Qdrant failed"
#   → Verifica que Qdrant esté corriendo (local o cloud)
#   → Comprueba que la URL y key sean correctas
#
# Advertencia: "Failed to export span batch code: 401"
#   → Es normal si no configuraste Langfuse
#   → Puedes ignorarlo, no afecta la funcionalidad
#
# Error: "No PDF files found"
#   → Verifica que DIR_PDF apunte a un directorio válido
#   → Asegúrate de que haya archivos .pdf en ese directorio
